POSTGRES_DB=pos_dev
POSTGRES_USER=pos_dev
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg2://pos_dev:change-me@db:5432/pos_dev
JWT_SECRET_KEY=change-me-to-a-random-32-byte-or-longer-secret

ENVIRONMENT=development
DEBUG=false
ENABLE_API_DOCS=true
SEED_DEMO_DATA=true

# Required when SEED_DEMO_DATA=true.
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_MANAGER_PASSWORD=change-me-manager-password
SEED_CASHIER_PASSWORD=change-me-cashier-password
SEED_STOCK_PASSWORD=change-me-stock-password

REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
